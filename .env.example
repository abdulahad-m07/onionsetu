# OnionSetu Environment Configuration Template
ENVIRONMENT=dev
DEBUG=True

# Database Configuration
# Docker Postgres (see docker-compose.yml): user onionsetu_admin,
# password secure_postgres_password_dev, db onionsetu_db.
# From inside the backend container the host is `postgres`; when running
# uvicorn directly on localhost, use `localhost` as below.
DATABASE_URL=postgresql+asyncpg://onionsetu_admin:secure_postgres_password_dev@localhost:5432/onionsetu_db

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Supabase Cloud Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_IMAGES=onion-evidence-images
SUPABASE_BUCKET_REPORTS=onion-digital-reports

# Grading Policy
GRADING_POLICY_VERSION=v1.0.0

# Public base URL of this deployment (used for report QR verification links).
PUBLIC_BASE_URL=http://localhost:8000

# Roboflow Hosted Vision Inference (SERVER-SIDE ONLY)
# Never copy this key into Flutter code, assets, or any committed file.
# Set via environment. The previously committed example value was redacted;
# rotate the key in the Roboflow dashboard if it was ever a live key.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=onion-yhzc7-mo9ib/1
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_TIMEOUT_SECONDS=30
ROBOFLOW_MIN_CONFIDENCE=45
ROBOFLOW_OVERLAP=30

# Batch Visual Assessment via OpenRouter (SERVER-SIDE ONLY)
# Same secrecy rules as ROBOFLOW_API_KEY: key in Authorization header only,
# never in URLs/bodies/logs/responses, never committed. Names only here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_IMAGES=15
OPENROUTER_MAX_IMAGE_DIM=1024

# Deterministic Batch Grading Policy (A/B/C/Reject)
# BLOCKER: no official APMC thresholds exist in this repo; all values are
# explicitly PROVISIONAL until officially signed off (see
# docs/MODEL_INTEGRATION_SPEC.md and BATCH_POLICY_VERSION).
BATCH_POLICY_VERSION=v0.2-provisional
BATCH_MIN_ASSESSMENT_CONFIDENCE=0.70
BATCH_FALLBACK_GRADE=Reject
BATCH_MAX_GRADE_WITH_HIGH_SEVERITY=C
# Multi-view batch capture: 10-15 views of the SAME physical batch.
BATCH_MIN_VIEWS=10
# Grader-declared physical batch size range (the ONLY URS% denominator).
BATCH_MIN_ASSESSED_ONIONS=100
BATCH_MAX_ASSESSED_ONIONS=200
